# Hermes Agent connection
HERMES_API_TOKEN=your_token_here

# AgentHub auth (required)
AGENTHUB_PASSWORD=your_password
AGENTHUB_SESSION_SECRET=your_random_secret_at_least_32_chars

# Image generation (optional)
AGENTHUB_IMAGE_API_URL=https://your-image-api/v1
AGENTHUB_IMAGE_API_TOKEN=your_token
AGENTHUB_IMAGE_MODEL=your-model
